<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include the Room database files for cloud backup -->
        <include domain="database" path="milk_database"/>
        <include domain="database" path="milk_database-shm"/>
        <include domain="database" path="milk_database-wal"/>
    </cloud-backup>
    <device-transfer>
        <!-- Include the Room database files for device-to-device transfer -->
        <include domain="database" path="milk_database"/>
        <include domain="database" path="milk_database-shm"/>
        <include domain="database" path="milk_database-wal"/>
    </device-transfer>
</data-extraction-rules>
